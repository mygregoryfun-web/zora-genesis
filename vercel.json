{
  "version": 2,
  "builds": [
    {
      "src": "api/home.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/preview.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/video.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/agent/draft.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai-video-generate.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai-video-task.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/home.ts"
    },
    {
      "src": "/favicon.ico",
      "dest": "/api/health.ts"
    },
    {
      "src": "/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/preview",
      "dest": "/api/preview.ts"
    },
    {
      "src": "/video",
      "dest": "/api/video.ts"
    },
    {
      "src": "/api/video/generate",
      "dest": "/api/ai-video-generate.ts"
    },
    {
      "src": "/api/video/task",
      "dest": "/api/ai-video-task.ts"
    },
    {
      "src": "/base-grant",
      "dest": "/api/home.ts"
    },
    {
      "src": "/agent/draft",
      "dest": "/api/agent/draft.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/api/preview",
      "dest": "/api/preview.ts"
    },
    {
      "src": "/api/video",
      "dest": "/api/video.ts"
    },
    {
      "src": "/api/agent/draft",
      "dest": "/api/agent/draft.ts"
    }
  ]
}
