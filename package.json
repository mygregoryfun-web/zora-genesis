{
  "name": "zora-genesis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "start": "node dist/server.js",
    "run:once": "node dist/cli.js",
    "check:x": "node dist/channel-run.js x",
    "check:farcaster": "node dist/channel-run.js farcaster",
    "check:zora": "node dist/channel-run.js zora",
    "preview:x": "node dist/channel-run.js x",
    "preview:farcaster": "node dist/channel-run.js farcaster",
    "preview:zora": "node dist/channel-run.js zora",
    "publish:x": "node dist/channel-run.js x --live",
    "publish:farcaster": "node dist/channel-run.js farcaster --live",
    "publish:zora": "node dist/channel-run.js zora --live",
    "proof:check": "node scripts/deploy-zora-genesis-proof.mjs",
    "proof:check:testnet": "node scripts/deploy-zora-genesis-proof.mjs --network=base-sepolia",
    "fb:post": "tsx src/facebook-cli.ts",
    "register": "tsx src/test-register.ts",
    "hol:register": "tsx src/hol.ts",
    "hol:resolve": "tsx src/hol-resolve.ts",
    "hol:update": "tsx src/hol-update.ts",
    "docker:build": "docker build -t zora-genesis .",
    "docker:run": "docker run --env-file .env zora-genesis"
  },
  "dependencies": {
    "@zoralabs/coins-sdk": "^0.7.1",
    "axios": "^1.18.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.1",
    "viem": "2.53.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@hashgraphonline/standards-sdk": "^0.1.184",
    "@hol-org/rb-client": "^0.1.184",
    "@types/node": "^24.13.3",
    "solc": "^0.8.36",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
